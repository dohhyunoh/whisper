{
  "expo": {
    "name": "Whisper",
    "slug": "Whisper",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "whisper",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.dohhyun.whisper",
      "buildNumber": "2",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "instagram",
          "instagram-stories",
          "whatsapp",
          "twitter",
          "fb"
        ],
        "NSPhotoLibraryAddUsageDescription": "Whisper needs access to save quote images to your photo library."
      },
      "appleTeamId": "37RJ9492PN",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.dohhyun.whisper"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.dohhyun.whisper"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#A6D9F1"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Whisper needs access to your photos to set a custom background.",
          "cameraPermission": "Whisper needs access to your camera to take a photo for your background."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "entitlements": {
              "com.apple.security.application-groups": [
                "group.com.dohhyun.whisper"
              ]
            }
          }
        }
      ],
      "@bacons/apple-targets",
      "react-native-appsflyer",
      ["expo-tracking-transparency", {
        "userTrackingPermission": "This identifier will be used to measure advertising performance and deliver personalized ads."
      }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "32d06225-5c8a-449f-a7a9-f864caa25a2d"
      }
    }
  }
}
