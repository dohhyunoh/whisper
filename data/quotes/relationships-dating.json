[
  {
    "id": "rel-dating-001",
    "text": "I don't have a girlfriend. But I do know a woman who'd be mad at me for saying that.",
    "author": "Mitch Hedberg",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "playful",
    "tags": [
      "situation:dating",
      "situation:single-by-choice",
      "theme:romantic-love",
      "tone:playful"
    ]
  },
  {
    "id": "rel-dating-003",
    "text": "A kiss that is never tasted, is forever and ever wasted.",
    "author": "Billie Holiday",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "theme:romantic-love",
      "emotion:longing",
      "tone:poetic",
      "tone:gentle"
    ]
  },
  {
    "id": "rel-dating-006",
    "text": "Kissing someone is pretty intimate, actually very intimate, and your heart always kind of skips a beat before you do that.",
    "author": "Keanu Reeves",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "situation:dating",
      "theme:romantic-love",
      "tone:gentle"
    ]
  },
  {
    "id": "rel-dating-010",
    "text": "I was dating this guy, and we would spend all day text messaging each other. He thought he could tell that he liked me more because he actually spelled the word 'you,' and I just put the letter 'u.'",
    "author": "Kelly Osbourne",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "playful",
    "tags": [
      "situation:dating",
      "tone:playful"
    ]
  },
  {
    "id": "rel-dating-012",
    "text": "Before you marry a person, you should first make them use a computer with slow Internet service to see who they really are.",
    "author": "Will Ferrell",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "playful",
    "tags": [
      "situation:dating",
      "need:perspective",
      "tone:playful"
    ]
  },
  {
    "id": "rel-dating-015",
    "text": "Never let a fool kiss you, or a kiss fool you.",
    "author": "Joey Adams",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "playful",
    "tags": [
      "situation:dating",
      "need:perspective",
      "tone:playful"
    ]
  },
  {
    "id": "rel-dating-016",
    "text": "In its purest form, dating is auditioning for a life partnership, and auditioning means we may or may not get the part.",
    "author": "Joy Browne",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "playful",
    "tags": [
      "situation:dating",
      "need:perspective",
      "tone:direct",
      "tone:playful"
    ]
  },
  {
    "id": "rel-dating-021",
    "text": "You're late. You're stunning. You're forgiven.",
    "author": "Edward Lewis",
    "source": "Pretty Woman",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "playful",
    "tags": [
      "situation:dating",
      "theme:romantic-love",
      "tone:playful"
    ]
  },
  {
    "id": "rel-dating-022",
    "text": "I realize this comes at a very inopportune time, but I really have this gigantic favor to ask of you: Choose me. Marry me. Let me make you happy.",
    "author": "Michael",
    "source": "My Best Friend's Wedding",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "theme:romantic-love",
      "emotion:longing",
      "tone:gentle"
    ]
  },
  {
    "id": "rel-dating-023",
    "text": "Dating is pressure and tension. What is a date, really, but a job interview that lasts all night?",
    "author": "Jerry Seinfeld",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "playful",
    "tags": [
      "situation:dating",
      "emotion:anxiety",
      "tone:playful"
    ]
  },
  {
    "id": "rel-dating-024",
    "text": "A girl phoned me the other day and said... 'Come on over, there's nobody home.' I went over. Nobody was home.",
    "author": "Rodney Dangerfield",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "playful",
    "tags": [
      "situation:dating",
      "tone:playful"
    ]
  },
  {
    "id": "rel-dating-026",
    "text": "True love is singing karaoke 'Under Pressure' and letting the other person sing the Freddie Mercury part.",
    "author": "Mindy Kaling",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "playful",
    "tags": [
      "theme:romantic-love",
      "tone:playful"
    ]
  },
  {
    "id": "rel-dating-027",
    "text": "Love is telling someone their hair extensions are showing.",
    "author": "Natasha Leggero",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "playful",
    "tags": [
      "theme:romantic-love",
      "tone:playful"
    ]
  },
  {
    "id": "rel-dating-031",
    "text": "Did you know that the institution of marriage was created when the average person lived to the age of 30?",
    "author": "Kim",
    "source": "The Last Kiss",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "playful",
    "tags": [
      "situation:dating",
      "need:perspective",
      "tone:playful"
    ]
  },
  {
    "id": "rel-dating-035",
    "text": "I fell in love the way you fall asleep: slowly, and then all at once.",
    "author": "John Green",
    "source": "The Fault in Our Stars",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "theme:romantic-love",
      "emotion:joy",
      "tone:poetic",
      "tone:gentle"
    ]
  },
  {
    "id": "rel-dating-036",
    "text": "When you realize you want to spend the rest of your life with somebody, you want the rest of your life to start as soon as possible.",
    "author": "Harry",
    "source": "When Harry Met Sally",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "theme:romantic-love",
      "emotion:hope",
      "tone:gentle"
    ]
  },
  {
    "id": "rel-dating-037",
    "text": "I'm scared of walking out of this room and never feeling the rest of my whole life the way I feel when I'm with you.",
    "author": "Baby",
    "source": "Dirty Dancing",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "theme:romantic-love",
      "emotion:longing",
      "emotion:fear",
      "tone:gentle"
    ]
  },
  {
    "id": "rel-dating-042",
    "text": "Dating is really hard because everyone puts on a front. It's really difficult to see who is who, so it is important to be yourself.",
    "author": "Brooke Burke",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "direct",
    "tags": [
      "situation:dating",
      "theme:identity",
      "need:perspective",
      "tone:direct"
    ]
  },
  {
    "id": "rel-dating-043",
    "text": "I love you. You annoy me more than I ever thought possible. But I want to spend every irritating minute with you.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "playful",
    "tags": [
      "theme:romantic-love",
      "tone:playful"
    ]
  },
  {
    "id": "rel-dating-044",
    "text": "If I had a flower for every time I thought of you, I could walk through my garden forever.",
    "author": "Alfred Tennyson",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "theme:romantic-love",
      "emotion:longing",
      "tone:poetic",
      "tone:gentle"
    ]
  },
  {
    "id": "rel-dating-045",
    "text": "The couples that are meant to be are the ones who go through everything that is meant to tear them apart and come out even stronger.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "theme:romantic-love",
      "theme:healing",
      "need:motivation",
      "tone:gentle"
    ]
  },
  {
    "id": "rel-dating-048",
    "text": "You know it's love when all you want is that person to be happy, even if you're not part of their happiness.",
    "author": "Julia Roberts",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "theme:romantic-love",
      "theme:letting-go",
      "need:perspective",
      "tone:gentle"
    ]
  },
  {
    "id": "rel-dating-049",
    "text": "I love you without knowing how, or when, or from where. I love you simply, without problems or pride.",
    "author": "Pablo Neruda",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "theme:romantic-love",
      "tone:poetic",
      "tone:gentle"
    ]
  },
  {
    "id": "rel-dating-050",
    "text": "They slipped briskly into an intimacy from which they never recovered.",
    "author": "F. Scott Fitzgerald",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "playful",
    "tags": [
      "theme:romantic-love",
      "tone:poetic",
      "tone:playful"
    ]
  },
  {
    "id": "rel-dating-051",
    "text": "In online dating, I'm in the same category as someone who owns ferrets and has a mermaid tattoo.",
    "author": "Demetri Martin",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "playful",
    "tags": [
      "situation:dating",
      "tone:playful"
    ]
  },
  {
    "id": "rel-dating-053",
    "text": "I wish I had done everything on earth with you.",
    "author": "F. Scott Fitzgerald",
    "source": "The Great Gatsby",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "theme:romantic-love",
      "emotion:longing",
      "tone:gentle",
      "tone:poetic"
    ]
  },
  {
    "id": "rel-dating-054",
    "text": "Being deeply loved by someone gives you strength, while loving someone deeply gives you courage.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "theme:romantic-love",
      "need:motivation",
      "tone:gentle"
    ]
  },
  {
    "id": "rel-dating-056",
    "text": "I swear I couldn't love you more than I do right now, and yet I know I will tomorrow.",
    "author": "Leo Christopher",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "theme:romantic-love",
      "emotion:joy",
      "tone:gentle"
    ]
  },
  {
    "id": "rel-dating-058",
    "text": "The best relationships are the ones where you can be your complete, weird, unfiltered self and they still think you're the best thing ever.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "theme:romantic-love",
      "theme:self-worth",
      "need:validation",
      "tone:gentle"
    ]
  },
  {
    "id": "rel-dating-059",
    "text": "Dating someone with anxiety means understanding that sometimes we need reassurance, not because we don't trust you, but because our brain is mean to us.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "emotion:anxiety",
      "theme:romantic-love",
      "need:validation",
      "tone:gentle"
    ]
  },
  {
    "id": "rel-dating-062",
    "text": "I don't want perfect, I want honest.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "direct",
    "tags": [
      "theme:romantic-love",
      "need:perspective",
      "tone:direct"
    ]
  },
  {
    "id": "rel-dating-063",
    "text": "True love is when your heart and your mind are saying the same thing.",
    "author": "Leanna L. Bartram",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "theme:romantic-love",
      "need:perspective",
      "tone:gentle"
    ]
  },
  {
    "id": "rel-dating-064",
    "text": "When someone else's happiness is your happiness, that is love.",
    "author": "Lana Del Rey",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "theme:romantic-love",
      "tone:gentle"
    ]
  },
  {
    "id": "rel-dating-065",
    "text": "In a world full of temporary things, you are a perpetual feeling.",
    "author": "Sanober Khan",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "theme:romantic-love",
      "emotion:longing",
      "tone:poetic",
      "tone:gentle"
    ]
  },
  {
    "id": "rel-dating-066",
    "text": "The best love is the kind that awakens the soul and makes us reach for more, that plants a fire in our hearts and brings peace to our minds.",
    "author": "Noah",
    "source": "The Notebook",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "theme:romantic-love",
      "emotion:peace",
      "tone:poetic",
      "tone:gentle"
    ]
  },
  {
    "id": "rel-dating-068",
    "text": "I'd rather have bad times with you than good times with anyone else.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "theme:romantic-love",
      "tone:gentle"
    ]
  },
  {
    "id": "rel-dating-069",
    "text": "Every love story is beautiful, but ours is my favorite.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "theme:romantic-love",
      "emotion:joy",
      "tone:gentle"
    ]
  },
  {
    "id": "rel-dating-070",
    "text": "Love is not about how many days, months, or years you've been together. Love is about how much you love each other every single day.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "theme:romantic-love",
      "need:perspective",
      "tone:gentle"
    ]
  },
  {
    "id": "rel-dating-072",
    "text": "I'm sorry I couldn't eat all the canelés. I'm sorry I hit you so much... Thank you for everything. I love you. I love you. I love you.",
    "author": "Kaori Miyazono",
    "source": "Your Lie in April",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "theme:romantic-love",
      "emotion:grief",
      "emotion:longing",
      "tone:gentle"
    ]
  },
  {
    "id": "rel-dating-073",
    "text": "Date with intention, not desperation.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "direct",
    "tags": [
      "situation:dating",
      "theme:self-worth",
      "need:perspective",
      "tone:direct"
    ]
  },
  {
    "id": "rel-dating-074",
    "text": "The right one won't confuse you.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "situation:dating",
      "emotion:anxiety",
      "need:perspective",
      "tone:direct",
      "tone:gentle"
    ]
  },
  {
    "id": "rel-dating-075",
    "text": "Chemistry fades. Character stays.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "direct",
    "tags": [
      "situation:dating",
      "need:perspective",
      "tone:direct"
    ]
  },
  {
    "id": "rel-dating-076",
    "text": "Watch how they treat the waiter.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "direct",
    "tags": [
      "situation:dating",
      "need:perspective",
      "tone:direct"
    ]
  },
  {
    "id": "rel-dating-077",
    "text": "Know your worth before the date.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "direct",
    "tags": [
      "situation:dating",
      "theme:self-worth",
      "need:motivation",
      "tone:direct",
      "tone:fierce"
    ]
  },
  {
    "id": "rel-dating-078",
    "text": "Real connection doesn't need to rush.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "situation:dating",
      "situation:new-relationship",
      "need:perspective",
      "tone:gentle"
    ]
  },
  {
    "id": "rel-dating-079",
    "text": "Don't date potential. Date reality.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "direct",
    "tags": [
      "situation:dating",
      "theme:letting-go",
      "need:perspective",
      "tone:direct",
      "tone:fierce"
    ]
  },
  {
    "id": "rel-dating-080",
    "text": "A good match feels like peace.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "situation:dating",
      "emotion:peace",
      "need:perspective",
      "tone:gentle"
    ]
  },
  {
    "id": "rel-dating-081",
    "text": "Pay attention to how they listen.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "situation:dating",
      "need:perspective",
      "tone:gentle"
    ]
  },
  {
    "id": "rel-dating-082",
    "text": "If it's right, it won't drain you.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "situation:dating",
      "theme:boundaries",
      "need:perspective",
      "tone:direct"
    ]
  },
  {
    "id": "rel-dating-083",
    "text": "Don't settle for less than butterflies.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "direct",
    "tags": [
      "situation:dating",
      "theme:self-worth",
      "tone:direct"
    ]
  },
  {
    "id": "rel-dating-084",
    "text": "Make them nervous when you walk in.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "playful",
    "tags": [
      "situation:dating",
      "theme:self-worth",
      "need:motivation",
      "tone:playful",
      "tone:fierce"
    ]
  },
  {
    "id": "rel-dating-085",
    "text": "Good morning texts hit different.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "playful",
    "tags": [
      "situation:new-relationship",
      "theme:romantic-love",
      "emotion:joy",
      "tone:playful"
    ]
  },
  {
    "id": "rel-dating-086",
    "text": "The right kiss changes everything.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "situation:dating",
      "theme:romantic-love",
      "emotion:joy",
      "tone:gentle"
    ]
  },
  {
    "id": "rel-dating-087",
    "text": "If they wanted to, they would.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "direct",
    "tags": [
      "situation:dating",
      "theme:letting-go",
      "need:perspective",
      "tone:direct",
      "tone:fierce"
    ]
  },
  {
    "id": "rel-dating-088",
    "text": "You're the catch. Remember that.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "direct",
    "tags": [
      "theme:self-worth",
      "need:motivation",
      "tone:direct",
      "tone:fierce"
    ]
  },
  {
    "id": "rel-dating-089",
    "text": "The way they say your name matters.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "situation:new-relationship",
      "theme:romantic-love",
      "tone:gentle"
    ]
  },
  {
    "id": "rel-dating-090",
    "text": "Late night talks build the deepest bonds.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "situation:new-relationship",
      "theme:romantic-love",
      "tone:gentle"
    ]
  },
  {
    "id": "rel-dating-091",
    "text": "Slow love is the deepest kind.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "situation:new-relationship",
      "theme:romantic-love",
      "need:perspective",
      "tone:gentle"
    ]
  },
  {
    "id": "rel-dating-092",
    "text": "Your love story is worth the wait.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "situation:dating",
      "emotion:hope",
      "need:validation",
      "tone:gentle"
    ]
  },
  {
    "id": "rel-dating-093",
    "text": "Find someone who chooses you daily.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "gentle",
    "tags": [
      "situation:dating",
      "theme:romantic-love",
      "need:perspective",
      "tone:gentle"
    ]
  },
  {
    "id": "rel-dating-094",
    "text": "That nervous laugh? That's the one.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "playful",
    "tags": [
      "situation:new-relationship",
      "theme:romantic-love",
      "emotion:joy",
      "tone:playful"
    ]
  },
  {
    "id": "rel-dating-095",
    "text": "Eye contact is the most dangerous flirt.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "playful",
    "tags": [
      "situation:dating",
      "theme:romantic-love",
      "tone:playful"
    ]
  },
  {
    "id": "rel-dating-096",
    "text": "Chemistry you can't fake.",
    "author": "Unknown",
    "category": "relationships",
    "subcategory": "dating",
    "tone": "direct",
