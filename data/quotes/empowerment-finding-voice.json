    "category": "empowerment",
    "subcategory": "finding-voice",
    "tone": "direct",
    "tags": [
      "theme:identity",
      "need:motivation",
      "tone:direct",
      "tone:fierce"
    ]
  },
  {
    "id": "emp-voice-123",
    "text": "Stop whispering your dreams.",
    "author": "Unknown",
    "category": "empowerment",
    "subcategory": "finding-voice",
    "tone": "direct",
    "tags": [
      "theme:purpose",
      "need:motivation",
      "tone:direct",
      "tone:fierce"
    ]
  },
  {
    "id": "emp-voice-124",
    "text": "You are not too opinionated.",
    "author": "Unknown",
    "category": "empowerment",
    "subcategory": "finding-voice",
    "tone": "gentle",
    "tags": [
      "theme:self-worth",
      "need:validation",
      "tone:gentle"
    ]
  },
  {
    "id": "emp-voice-125",
    "text": "Set the tone. Don't follow it.",
    "author": "Unknown",
    "category": "empowerment",
    "subcategory": "finding-voice",
    "tone": "direct",
    "tags": [
      "theme:identity",
      "need:motivation",
      "tone:direct",
      "tone:fierce"
    ]
  },
  {
    "id": "emp-voice-126",
    "text": "Your no is a complete sentence.",
