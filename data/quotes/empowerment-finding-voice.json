    "category": "empowerment",
    "subcategory": "finding-voice",
    "tone": "direct",
    "tags": [
      "theme:boundaries",
      "need:permission",
      "tone:direct"
    ]
  },
  {
    "id": "emp-voice-127",
    "text": "Swallow fear, not your words.",
